{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/schema/b10x.status.v1.json",
  "title": "b10x product status",
  "description": "What exists today and what does not, generated by the repository. The landing page's status section and the status page's StatusTable read the same file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "items"],
  "properties": {
    "format": {"const": "b10x-status/1"},
    "asOf": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The date the statuses were last checked."},
    "source": {"type": "string", "minLength": 1, "description": "Provenance: what produced this file."},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "status"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "description": "Unique within the file."},
          "status": {"enum": ["shipped", "decided", "planned"]},
          "detail": {"type": "string", "minLength": 1},
          "href": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1, "description": "Optional grouping on the status page."}
        }
      }
    }
  }
}

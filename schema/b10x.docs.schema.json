{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/getting-started/schema/b10x.docs.v1.json",
  "title": "b10x documentation surfaces",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "surfaces"],
  "properties": {
    "schema": {"const": "b10x-docs/v1"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/beyond10x/"}
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/surface"}
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "kind": {"enum": ["docs", "quickstart", "api", "source", "security", "status", "feed", "reference"]}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "kind"],
      "properties": {
        "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["informs", "specifies", "implements", "hosts", "drives", "executes-in", "uses"]},
        "label": {"type": "string"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "kind", "canonicalUrl", "maturity", "availability", "discoverability", "journeys", "capabilities", "sections", "shell"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1, "maxLength": 240},
        "kind": {"enum": ["front-door", "documentation", "research", "service-docs", "reference", "updates"]},
        "canonicalUrl": {"type": "string", "format": "uri", "pattern": "^(https://|http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?/)"},
        "maturity": {"enum": ["stable", "development", "experimental"]},
        "availability": {"enum": ["published", "local-only", "planned"]},
        "discoverability": {"enum": ["public", "unlisted", "internal"]},
        "audiences": {"type": "array", "items": {"enum": ["evaluator", "adopter", "developer", "operator", "researcher"]}, "uniqueItems": true},
        "journeys": {"type": "array", "items": {"enum": ["understand", "specify", "build-agents", "operate-services"]}, "uniqueItems": true},
        "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
        "feeds": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "mark": {"type": "string"},
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integration", "revision"],
          "properties": {
            "integration": {"enum": ["docusaurus", "portable"]},
            "revision": {"type": "string", "pattern": "^(local|[0-9a-f]{40})$"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"discoverability": {"const": "public"}}, "required": ["discoverability"]},
          "then": {"properties": {"canonicalUrl": {"type": "string", "pattern": "^https://"}}}
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/schema/b10x.session-composition.v0.json",
  "title": "Session composition instance (provisional)",
  "description": "One working session mapped onto protocols, lanes and the composition behind it, for SessionTimeline, StepBars, CompositionGraph and SessionKpis. Provisional: the format string carries 0-dummy until a process specification owns it. Times are HH:MM:SS UTC on the window's start day. Names are roles, not people.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "window", "protocols", "lanes", "episodes", "decisions", "graph"],
  "properties": {
    "format": {"const": "session-composition-instance/0-dummy"},
    "composition": {"type": "string"},
    "window": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "sources": {"type": "array", "items": {"type": "string"}},
    "protocols": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "slot"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "slot": {"type": "integer", "minimum": 0, "maximum": 4}}}},
    "lanes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "principal": {"type": "string"}}}},
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "protocol", "start", "end", "label"],
        "properties": {
          "lane": {"type": "string"},
          "protocol": {"type": "string"},
          "start": {"$ref": "#/$defs/clock"},
          "end": {"$ref": "#/$defs/clock"},
          "label": {"type": "string"},
          "discarded": {"type": "boolean"},
          "approximate": {"type": "boolean"},
          "open": {"type": "boolean"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "title", "adr", "question", "decided", "relayed", "drafted"],
        "properties": {"n": {"type": "integer"}, "title": {"type": "string"}, "adr": {"type": "string"}, "question": {"$ref": "#/$defs/clock"}, "decided": {"$ref": "#/$defs/clock"}, "relayed": {"$ref": "#/$defs/clock"}, "drafted": {"$ref": "#/$defs/clock"}}
      }
    },
    "operator_marks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["t", "kind", "label"], "properties": {"t": {"$ref": "#/$defs/clock"}, "kind": {"type": "string"}, "label": {"type": "string"}}}},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "nodes", "edges"],
      "properties": {
        "columns": {"type": "array", "items": {"type": "string"}},
        "nodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "col", "label"], "properties": {"id": {"type": "string"}, "col": {"type": "integer", "minimum": 0}, "label": {"type": "string"}, "detail": {"type": "string"}, "policy": {"type": "string"}, "observed": {"type": "integer", "minimum": 0}, "slot": {"type": "integer", "minimum": 0, "maximum": 4}}}},
        "edges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}}
      }
    }
  },
  "$defs": {"clock": {"type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$"}}
}

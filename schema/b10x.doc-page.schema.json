{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/schema/b10x.doc-page.v1.json",
  "title": "beyond10x document page metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "audiences", "experienceIds"],
  "properties": {
    "schema": {"const": "b10x-doc-page/v1"},
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["evaluator", "adopter", "developer", "operator", "researcher"]}
    },
    "experienceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "support": {"enum": ["supported", "preview", "experimental", "paused", "planned", "retired"]},
    "access": {"enum": ["public", "account-required", "approval-required", "private"]}
  }
}
